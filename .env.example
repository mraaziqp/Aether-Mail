# AetherMail configuration. Copy to .env locally; set the same names in the
# Vercel project (Settings → Environment Variables).
#
# Config is env-only by design: no value below has a fallback in code, and a
# missing value produces a clear error instead of silently appearing to work.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres. Neon: use the *pooled* connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aethermail?sslmode=disable"

# Console sign-in. There is no default password.
ADMIN_USERNAME="mraaziqp"
ADMIN_PASSWORD=""

# Signs sessions and encrypts stored mailbox passwords. Generate once with
#   openssl rand -base64 32
# and never change it casually: stored mailbox passwords become unreadable and
# each mailbox must be reconnected.
APP_SECRET=""

# ---------------------------------------------------------------------------
# Business mail
# ---------------------------------------------------------------------------

# Default sender and business identity.
AETHERMAIL_SENDER="contact@arpcloudsolutions.co.za"
BUSINESS_NAME="ARP Cloud Solutions"
BUSINESS_DOMAIN="arpcloudsolutions.co.za"
# Addresses created up front (any other address on the domain is still captured).
BUSINESS_MAILBOXES="contact,info,sales,billing"
ADMIN_DISPLAY_NAME="Mohamed Raaziq"

# Resend — primary sending route for the business domain. The domain must be
# verified at resend.com/domains (DKIM + the send.<domain> MX/SPF records).
RESEND_API_KEY=""

# Optional: receive mail through Resend instead of (or as well as) IMAP.
# Webhook URL: https://<your-host>/api/webhooks/resend, event "email.received".
# Reading message bodies needs a full-access API key.
RESEND_WEBHOOK_SECRET=""

# IMAP fallback for accounts that do not store their own server. Mailboxes
# connected through the console store host + encrypted password per account,
# so these are only needed for the env-configured mailbox below.
# Zoho custom-domain mailboxes use the *pro* hosts (imappro/smtppro).
IMAP_HOST="imappro.zoho.com"
IMAP_PORT=993
IMAP_PROVIDER="zoho"
IMAP_SPAM_FOLDER="Spam"
# App-specific password for AETHERMAIL_SENDER's mailbox (used only when the
# account row carries no stored password).
IMAP_PASSWORD=""

# Generic SMTP relay, tried after Resend and the mailbox's own SMTP.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Gmail profiles (sending as Gmail, and last-resort relay for business mail
# with Reply-To set). Set ALLOW_GMAIL_RELAY=false to never send business mail
# from the Gmail address.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
BACKUPE9_USER=""
BACKUPE9_APP_PASSWORD=""
ALLOW_GMAIL_RELAY="true"

# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------

# Shared secret for /api/cron/sync. Vercel Cron sends it automatically; the
# GitHub Actions workflow (.github/workflows/mail-sync.yml) reads it from the
# repository secret of the same name.
CRON_SECRET=""

# Long-running server only (npm start / VPS): IMAP IDLE push + periodic sync.
BACKGROUND_SYNC="true"
SYNC_INTERVAL_SECONDS=60
IMAP_IDLE="true"
# Messages imported the first time a folder is seen.
IMAP_BACKFILL=50
# Set to false to skip the Sent folder.
IMAP_SYNC_SENT="true"

# Only for a mail server with a self-signed certificate (local testing).
# IMAP_ALLOW_SELF_SIGNED="true"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Public URL of this deployment (links in push alerts, PayFast ITN URL).
APP_URL="https://aethermail.arpcloudsolutions.co.za"

# AI triage, summaries, smart reply and natural-language search.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
# Or a local OpenAI-compatible server (Ollama / LM Studio):
# LOCAL_LLM_URL="http://localhost:11434/v1"
# LOCAL_LLM_MODEL="llama3.1:8b"

# Phone push for mail that needs action (ntfy). Topics are public to anyone who
# knows the name — use a long random string, or NTFY_URL + NTFY_TOKEN.
NTFY_TOPIC=""
# NTFY_URL="https://ntfy.sh"
# NTFY_TOKEN=""

# PayFast ITN → verified notifications filed into this mailbox.
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_NOTIFY_EMAIL="info@arpcloudsolutions.co.za"
# PAYFAST_SANDBOX="true"

# Jarvis agent default sender (falls back to AETHERMAIL_SENDER).
JARVIS_DEFAULT_SENDER=""

# Target database for scripts/sync-to-neon.ts only.
NEON_TARGET_URL=""
