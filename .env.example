# Database: Neon PostgreSQL or local Docker PostgreSQL
# Example: postgresql://postgres:postgres@localhost:5432/aethermail?sslmode=disable
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aethermail?sslmode=disable"

# AI Inference: Google Gemini API Key
# Acquired from https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Self-referencing URL for callbacks, webhooks, and reverse proxies
APP_URL="http://localhost:3000"

# NTFY.sh Push Notifications topic for P0 / Urgent Incident Alerts
# Subscribe on mobile via ntfy app (e.g. ntfy.sh/aethermail-noc-alerts)
NTFY_TOPIC="aethermail-noc-alerts"

# External EmailEngine / IMAP-SMTP Sync Engine API
# Local docker: http://localhost:3001/v1/messages/send
EMAIL_SYNC_API_URL="http://localhost:3001/v1/messages/send"

# Optional: EmailEngine API Token for outbound sync engine dispatch
EMAIL_SYNC_API_TOKEN=""

# Server binding
PORT=3000
NODE_ENV="development"

# Stalwart Mail Server (Rust) Integration
STALWART_API_URL="http://localhost:8080"
STALWART_ADMIN_USER="admin"
STALWART_ADMIN_SECRET="aethermail-stalwart-secret-key-change-in-prod"
STALWART_SMTP_HOST="localhost"
STALWART_SMTP_PORT=587
MAIL_SERVER_HOST="mail.aethermail.internal"

# Jarvis Autonomous Agent Identity
JARVIS_DEFAULT_SENDER="jarvis@aethermail.com"

# ---------------------------------------------------------------------------
# IMAP — which server holds the mail for a given address
# ---------------------------------------------------------------------------
# Gmail, Outlook and zoho.com addresses are recognised automatically. A business
# domain is not: contact@arpcloudsolutions.co.za says nothing about where its
# mailbox lives, so name the host explicitly.
IMAP_HOST="imap.zoho.com"
IMAP_PORT=993
IMAP_PROVIDER="zoho"
IMAP_SPAM_FOLDER="Spam"

# Password for AETHERMAIL_SENDER's mailbox, used by the unified sync when the
# account row carries no stored credential. For Zoho this is an application-
# specific password, not the account login.
IMAP_PASSWORD=""

# Only for a mail server presenting a self-signed certificate (e.g. a local
# Stalwart instance). Leave unset in production — it disables the check that
# protects these mailbox credentials in transit.
# IMAP_ALLOW_SELF_SIGNED="true"

# Gmail sending/sync profiles. Env-only by design: no literal fallbacks.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
BACKUPE9_USER=""
BACKUPE9_APP_PASSWORD=""

# Target database for scripts/sync-to-neon.ts, which copies the local accounts
# and emails into Neon. Deliberately separate from DATABASE_URL: that stays
# pointed at the local source. Set only when running that script.
NEON_TARGET_URL=""
